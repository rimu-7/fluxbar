#!/bin/bash
set -euo pipefail

TOOLCHAIN_SWIFTC="${SWIFT_EXEC:-$(xcrun --find swiftc)}"
COMPILER_VERSION=""
PRIVATE_INTERFACES=()
PUBLIC_INTERFACES=()
PREV=""

# Some CLT installs retain Swift 5.10 private interfaces alongside current
# public interfaces and runtime libraries. Swift prefers the private files.
# Overlay only mismatched files whose public interface matches our compiler.
for arg in "$@"; do
  if [ "$PREV" = "-L" ]; then
    for module in "$arg/PackageDescription.swiftmodule" "$arg/PackagePlugin.swiftmodule"; do
      for private in "$module/"*.private.swiftinterface; do
        [ -f "$private" ] || continue
        public="${private%.private.swiftinterface}.swiftinterface"
        [ -f "$public" ] || continue
        private_version="$(sed -n '2p' "$private")"
        public_version="$(sed -n '2p' "$public")"
        [ "$private_version" != "$public_version" ] || continue

        if [ -z "$COMPILER_VERSION" ]; then
          COMPILER_VERSION="$("$TOOLCHAIN_SWIFTC" --version 2>/dev/null | sed -n 's/.*Swift version \([^ ]*\).*/\1/p')"
        fi
        [ -n "$COMPILER_VERSION" ] || continue
        [[ "$public_version" == *"Swift version $COMPILER_VERSION "* ]] || continue
        PRIVATE_INTERFACES+=("$private")
        PUBLIC_INTERFACES+=("$public")
      done
    done
  fi
  PREV="$arg"
done

if [ ${#PRIVATE_INTERFACES[@]} -eq 0 ]; then
  exec "$TOOLCHAIN_SWIFTC" "$@"
fi

# Keep repaired imports separate from modules cached from the stale interfaces.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CACHE_DIR="$ROOT/.build/swiftpm-module-cache"
mkdir -p "$CACHE_DIR"
OVERLAY="$(mktemp "$CACHE_DIR/overlay.XXXXXX")"
trap 'rm -f "$OVERLAY"' EXIT

json_string() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '"%s"' "$value"
}

{
  printf '{"version":0,"roots":['
  for ((i = 0; i < ${#PRIVATE_INTERFACES[@]}; i++)); do
    if [ "$i" -gt 0 ]; then printf ','; fi
    printf '{"type":"file","name":'
    json_string "${PRIVATE_INTERFACES[$i]}"
    printf ',"external-contents":'
    json_string "${PUBLIC_INTERFACES[$i]}"
    printf '}'
  done
  printf ']}\n'
} > "$OVERLAY"

"$TOOLCHAIN_SWIFTC" "$@" -vfsoverlay "$OVERLAY" -module-cache-path "$CACHE_DIR"
